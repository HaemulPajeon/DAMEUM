# 32바이트 이상의 임의 문자열을 사용하세요: python -c "import secrets; print(secrets.token_urlsafe(48))"
DAMEUM_API_KEY=replace-with-at-least-32-random-characters
# pydantic-settings의 list 환경변수 형식에 맞춘 JSON 배열
DAMEUM_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173"]
DAMEUM_DATA_DIR=./data
DAMEUM_INFERENCE_BACKEND=real

# llama.cpp의 OpenAI 호환 서버. Qwen3-1.7B GGUF를 별도 프로세스로 실행합니다.
DAMEUM_LLM_BASE_URL=http://127.0.0.1:8081/v1
DAMEUM_LLM_API_KEY=local-only
DAMEUM_LLM_MODEL=Qwen3-1.7B

DAMEUM_STT_MODEL=openai/whisper-small
# dameum-fastapi 디렉터리 기준의 구음장애 음성 LoRA 어댑터
DAMEUM_STT_ADAPTER_DIR=./artifacts/stt/whisper-small-lora-dysarthria
DAMEUM_STT_ADAPTER_SHA256=9772a95bfd1d77716ddae060790a6c40ad80f65a31d551caf7ce12f5a242ecbe
DAMEUM_EMOTION_MODEL=jeongyoonhuh/koelectra-emotion-6class
DAMEUM_VOXCPM_MODEL=openbmb/VoxCPM2
DAMEUM_CPU_THREADS=4
DAMEUM_UNLOAD_MODELS_AFTER_JOB=true
